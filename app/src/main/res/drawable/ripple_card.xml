<?xml version="1.0" encoding="utf-8"?>
<!-- Touch feedback for 24 dp glass cards (drawn as foreground, clipped to the card shape). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14152B3F">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
