        android:angle="0"
        android:centerColor="#F4FBFC"
        android:centerX="0.62"
        android:endColor="#FFF0E8"
        android:startColor="#FFFFFF"
        android:type="linear" />
    <corners android:radius="28dp" />
</shape>
