<?xml version="1.0" encoding="utf-8"?>
<!--
    Design tokens copied exactly from the RutaRescue Figma file (local variables and styles).
    The names on the left are the Figma variable names; keep both in sync when the design changes.
-->
<resources>
    <!-- Brand -->
    <color name="rr_navy">#152B3F</color>            <!-- color/brand/800 -->
    <color name="rr_navy_light">#24547F</color>      <!-- color/brand/600 -->
    <color name="rr_teal">#12B5D0</color>            <!-- color/accent/cyan (eyebrows) -->
    <color name="rr_cyan_icon">#08A9D1</color>       <!-- cyan icon strokes -->
    <color name="rr_teal_green">#0E9F8A</color>      <!-- teal icon strokes (centers) -->
    <color name="rr_accent_teal">#15A38B</color>     <!-- color/accent/teal -->
    <color name="rr_teal_soft">#E2F7FB</color>       <!-- color/status/info-soft (icon tiles, info notes) -->

    <!-- Surfaces -->
    <color name="rr_background">#F7F7F5</color>      <!-- color/surface/canvas -->
    <color name="rr_surface">#FFFFFF</color>         <!-- color/surface/primary -->
    <color name="rr_glass">#EDFFFFFF</color>         <!-- color/surface/glass: white at 93% -->
    <color name="rr_surface_secondary">#F1F3F4</color> <!-- color/surface/secondary -->
    <color name="rr_aura_cyan">#DDF8FC</color>       <!-- color/aura/cyan -->
    <color name="rr_aura_lilac">#F1EDFF</color>      <!-- color/aura/lilac -->
    <color name="rr_aura_peach">#FFF0E8</color>      <!-- color/aura/peach -->
    <color name="white">#FFFFFF</color>

    <!-- Text and lines -->
    <color name="rr_text">#162235</color>            <!-- color/text/primary -->
    <color name="rr_text_secondary">#667085</color>  <!-- color/text/secondary -->
    <color name="rr_text_subtle">#98A2B3</color>     <!-- color/text/subtle (inactive nav icons) -->
    <color name="rr_icon_muted">#94A3B8</color>      <!-- chevrons -->
    <color name="rr_icon_search">#64748B</color>     <!-- search icon -->
    <color name="rr_divider">#E8EAED</color>         <!-- color/border/default -->

    <!-- Status (Figma "RR / Status Chip") -->
    <color name="rr_orange">#D89025</color>          <!-- color/status/warning -->
    <color name="rr_orange_soft">#FFF4DF</color>     <!-- color/status/warning-soft -->
    <color name="rr_red">#DF5B59</color>             <!-- color/status/danger -->
    <color name="rr_red_soft">#FCECEA</color>        <!-- color/status/danger-soft -->
    <color name="rr_green">#21956F</color>           <!-- color/status/success -->
    <color name="rr_green_soft">#F1F3F4</color>      <!-- Figma "Status=Safe" chip background -->
    <color name="rr_grey_soft">#F1F3F4</color>       <!-- color/surface/secondary -->
    <!-- Not in the Figma palette: used only for "unverified bridge" route segments and badges. -->
    <color name="rr_violet">#7C5CC4</color>
    <color name="rr_violet_soft">#EFEAFB</color>

    <!-- Official NOAH legend (DOCX section 7) -->
    <color name="hazard_low">#F5C842</color>
    <color name="hazard_medium">#F08C2E</color>
    <color name="hazard_high">#E0483E</color>

    <!-- Route segment colours on the map -->
    <color name="route_clear">#1F6FEB</color>
    <color name="route_unverified">#7C5CC4</color>
    <color name="route_closed">#1B1B1F</color>
    <color name="route_other">#9AA6B2</color>
    <color name="route_no_data">#7A8796</color>
</resources>
