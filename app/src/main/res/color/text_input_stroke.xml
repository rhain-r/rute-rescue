<?xml version="1.0" encoding="utf-8"?>
<!-- Form field outline: brand-600 while focused, #E8EAED otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/rr_navy_light" android:state_focused="true" />
    <item android:color="@color/rr_navy_light" android:state_hovered="true" />
    <item android:color="@color/rr_divider" android:state_enabled="false" />
    <item android:color="@color/rr_divider" />
</selector>
