<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma "LGU / Hazard Map": full-screen map; "LGU Map Header" (44 dp Back, 48 dp glass Map Title
    pill, 44 dp More); Layer Filters pills; Locate / Layers buttons; floating "Hazard Layer Bottom
    Sheet" (glass, 30 dp corners, 16 dp from the edges and the navigation bar).
    DOCX additions in the same style: the Risk Horizon (5/25/100-year) pills, structure status and
    closure actions for the selected point, and the jurisdiction's active closures.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/lgu_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/lgu_map_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp">

        <!-- "LGU Map Header": 10 dp gaps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/lgu_back"
                style="@style/RR.MapButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_back" />

            <!-- "Map Title": glass pill, padding 0/14, 20 dp map icon, Section title + Micro meta -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_map_title"
                android:elevation="@dimen/elevation_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_map"
                    app:tint="@color/rr_navy_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/flood_risk_map"
                        android:textAppearance="@style/TextAppearance.RR.Section" />

                    <TextView
                        android:id="@+id/lgu_map_layer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.RR.Micro" />
                </LinearLayout>

                <!-- Info tooltip: the risk zones are prepared scenarios, not live weather -->
                <ImageButton
                    android:id="@+id/lgu_map_info"
                    style="@style/RR.InfoButton"
                    android:layout_marginEnd="-6dp"
                    android:contentDescription="@string/cd_about_risk_zones" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/lgu_more"
                style="@style/RR.MapButton"
                android:contentDescription="@string/cd_more"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <!-- "Layer Filters": map pills, 8 dp apart -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/lgu_layer_zones"
                    style="@style/Widget.RR.Chip.Map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/layer_risk_zones" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/lgu_layer_structures"
                    style="@style/Widget.RR.Chip.Map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/layer_structures" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/lgu_layer_centers"
                    style="@style/Widget.RR.Chip.Map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/layer_centers" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Risk Horizon (DOCX section 7) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/lgu_scenario_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/lgu_scenario_5"
                    style="@style/Widget.RR.Chip.Map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/scenario_5" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/lgu_scenario_25"
                    style="@style/Widget.RR.Chip.Map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scenario_25" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/lgu_scenario_100"
                    style="@style/Widget.RR.Chip.Map"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/scenario_100" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- "Map Controls": Locate and Layers, 8 dp apart, 210 dp below the top of the content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="210dp"
        android:layout_marginEnd="18dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/lgu_locate"
            style="@style/RR.MapButton"
            android:contentDescription="@string/cd_locate"
            android:src="@drawable/ic_my_location" />

        <ImageButton
            android:id="@+id/lgu_layers"
            style="@style/RR.MapButton"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/cd_layers"
            android:src="@drawable/ic_layers" />
    </LinearLayout>

    <!--
        Floating sheet card: 16 dp from the sides and above the 78 dp navigation bar. It grows with
        its content and scrolls inside once it reaches its maximum height (MaxHeightScrollView).
    -->
    <com.rutarescue.ui.common.MaxHeightScrollView
        android:id="@+id/lgu_map_sheet"
        style="@style/RR.Sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/bottom_nav_space"
        android:maxHeight="400dp"
        android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- "Sheet Handle" -->
                <View
                    android:layout_width="44dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_drag_handle" />

                <TextView
                    android:id="@+id/lgu_map_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_map_hint"
                    android:textAppearance="@style/TextAppearance.RR.Body" />

                <LinearLayout
                    android:id="@+id/lgu_selection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- "Sheet Title": Mobile/Section + status chip -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="29dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lgu_sel_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.RR.Section" />

                        <TextView
                            android:id="@+id/lgu_sel_hazard_badge"
                            style="@style/RR.Badge"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <!-- "Details": Mobile/Body -->
                    <TextView
                        android:id="@+id/lgu_sel_hazard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAppearance="@style/TextAppearance.RR.Body" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lgu_sel_structure"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.RR.Body" />

                        <TextView
                            android:id="@+id/lgu_sel_structure_badge"
                            style="@style/RR.Badge"
                            android:layout_marginStart="8dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lgu_sel_closure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.RR.Body" />

                    <!-- "Prepared Data Notice": 14 dp corners, padding 8/10, 18 dp info icon -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_notice_compact"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp"
                        android:text="@string/prepared_dataset_warning"
                        android:textAppearance="@style/TextAppearance.RR.Caption"
                        android:textColor="@color/rr_orange"
                        app:drawableStartCompat="@drawable/ic_info"
                        app:drawableTint="@color/rr_orange" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lgu_sel_set_status"
                        style="@style/Widget.RR.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:minHeight="50dp"
                        android:text="@string/set_structure_status"
                        app:icon="@drawable/ic_arrow_right" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lgu_sel_report_closure"
                        style="@style/Widget.RR.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/report_closure_here"
                        app:icon="@drawable/ic_warning" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lgu_sel_lift_closure"
                        style="@style/Widget.RR.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/lift_closure"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lgu_closures_title"
                    style="@style/RR.SectionHeader"
                    android:text="@string/active_closures" />

                <LinearLayout
                    android:id="@+id/lgu_closure_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
    </com.rutarescue.ui.common.MaxHeightScrollView>
</FrameLayout>
