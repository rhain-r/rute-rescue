<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 1 frame "LGU / Data & Centers / Center capacity" (and its offline state).
    Toolbar (Back, title, More), an orange "Pending sync" banner when changes wait to upload,
    then glass 24 dp cards: center name and location chips; headcount with the gauge, quick
    buttons and exact field; status pills; facility checkboxes; the grey last-change line.
    A glass save bar stays at the bottom.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/capacity_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toolbar: 44 dp Back, Mobile/Title, 44 dp More -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <ImageButton
            android:id="@+id/toolbar_back"
            style="@style/RR.MapButton"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/center_capacity"
            android:textAppearance="@style/TextAppearance.RR.Title" />

        <ImageButton
            android:id="@+id/capacity_more"
            style="@style/RR.MapButton"
            android:contentDescription="@string/cd_more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- Pending sync banner -->
            <LinearLayout
                android:id="@+id/capacity_pending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pending"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_offline"
                    app:tint="@color/rr_pending_text" />

                <TextView
                    android:id="@+id/capacity_pending_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.RR.Label"
                    android:textColor="@color/rr_pending_text" />
            </LinearLayout>

            <!-- Center name and location -->
            <LinearLayout style="@style/RR.CapacityCard">

                <TextView
                    android:id="@+id/capacity_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RR.Section"
                    tools:text="Almario Elementary School" />

                <TextView
                    android:id="@+id/capacity_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption"
                    android:textColor="@color/rr_text_secondary"
                    tools:text="Barangay 20 · Manila" />

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp">

                    <TextView
                        android:id="@+id/capacity_location_chip"
                        style="@style/RR.SoftChip"
                        tools:text="Location verified" />

                    <TextView
                        android:id="@+id/capacity_landmark_chip"
                        style="@style/RR.SoftChip"
                        android:textColor="@color/rr_text_secondary"
                        tools:text="Landmark: beside Brgy. 20 hall" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <!-- Headcount -->
            <LinearLayout style="@style/RR.CapacityCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/RR.GroupLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/current_headcount" />

                    <TextView
                        android:id="@+id/capacity_level_chip"
                        style="@style/RR.SoftChip"
                        tools:text="Near capacity" />
                </LinearLayout>

                <!-- Capacity not set yet -->
                <LinearLayout
                    android:id="@+id/capacity_unset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/capacity_not_set"
                        android:textAppearance="@style/TextAppearance.RR.Body"
                        android:textColor="@color/rr_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/capacity_set_total"
                        style="@style/Widget.RR.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:minHeight="48dp"
                        android:text="@string/set_capacity" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/capacity_counts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/capacity_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.RR.Display"
                            tools:text="212" />

                        <TextView
                            android:id="@+id/capacity_of"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textAppearance="@style/TextAppearance.RR.Body"
                            android:textColor="@color/rr_text_secondary"
                            tools:text="of 300 people · 71%" />
                    </LinearLayout>

                    <com.rutarescue.ui.common.CapacityGaugeView
                        android:id="@+id/capacity_gauge"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="8dp" />

                    <!-- Threshold labels under the 70% and 90% marks (placed by the activity) -->
                    <FrameLayout
                        android:id="@+id/capacity_scale"
                        android:layout_width="match_parent"
                        android:layout_height="14dp">

                        <TextView
                            style="@style/RR.GaugeLabel"
                            android:text="0" />

                        <TextView
                            android:id="@+id/capacity_scale_70"
                            style="@style/RR.GaugeLabel"
                            android:text="70%" />

                        <TextView
                            android:id="@+id/capacity_scale_90"
                            style="@style/RR.GaugeLabel"
                            android:text="90%" />
                    </FrameLayout>

                    <!-- Quick buttons: -10 -5 -1 / +1 +5 +10 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/capacity_minus10"
                            style="@style/RR.Step"
                            android:text="−10" />

                        <TextView
                            android:id="@+id/capacity_minus5"
                            style="@style/RR.Step"
                            android:layout_marginStart="8dp"
                            android:text="−5" />

                        <TextView
                            android:id="@+id/capacity_minus1"
                            style="@style/RR.Step"
                            android:layout_marginStart="8dp"
                            android:text="−1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/capacity_plus1"
                            style="@style/RR.Step.Plus"
                            android:text="+1" />

                        <TextView
                            android:id="@+id/capacity_plus5"
                            style="@style/RR.Step.Plus"
                            android:layout_marginStart="8dp"
                            android:text="+5" />

                        <TextView
                            android:id="@+id/capacity_plus10"
                            style="@style/RR.Step.Plus"
                            android:layout_marginStart="8dp"
                            android:text="+10" />
                    </LinearLayout>

                    <!-- Exact headcount + Set -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/capacity_field"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_field"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:id="@+id/capacity_field_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/karla_medium"
                                android:text="@string/exact_headcount"
                                android:textColor="@color/rr_text_secondary"
                                android:textSize="10sp" />

                            <EditText
                                android:id="@+id/capacity_exact"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:fontFamily="@font/karla_bold"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="6"
                                android:padding="0dp"
                                android:textColor="@color/rr_text"
                                android:textSize="16sp"
                                tools:text="212" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/capacity_set"
                            style="@style/Widget.RR.Button.Primary"
                            android:layout_width="72dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:minHeight="0dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            android:text="@string/set"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/capacity_limit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.RR.Caption"
                        android:textColor="@color/rr_text_secondary"
                        tools:text="The limit is 360 people (120% of capacity)." />
                </LinearLayout>
            </LinearLayout>

            <!-- Status -->
            <LinearLayout style="@style/RR.CapacityCard">

                <TextView
                    style="@style/RR.GroupLabel"
                    android:text="@string/status_label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/capacity_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:selectionRequired="false"
                    app:singleSelection="true" />

                <TextView
                    android:id="@+id/capacity_status_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption"
                    android:textColor="@color/rr_text_secondary" />
            </LinearLayout>

            <!-- Facilities -->
            <LinearLayout style="@style/RR.CapacityCard">

                <TextView
                    style="@style/RR.GroupLabel"
                    android:text="@string/facilities" />

                <GridLayout
                    android:id="@+id/capacity_facilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:columnCount="2" />
            </LinearLayout>

            <!-- Last change -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_audit"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/rr_text_secondary" />

                <TextView
                    android:id="@+id/capacity_audit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.RR.Caption"
                    android:textColor="@color/rr_text" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Save bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_savebar"
        android:elevation="@dimen/elevation_nav"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/capacity_save"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:minHeight="50dp"
            android:text="@string/save_changes" />
    </LinearLayout>
</LinearLayout>
