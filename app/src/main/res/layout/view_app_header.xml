<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma "RR / Header / Resident" and "RR / Header / LGU" (412 x 74 dp):
    glass bar, 26 dp bottom corners, padding 12/16/10/16, 12 dp gaps, Elevation/Sm.
    The eyebrow text is switched to "LGU OPERATIONS" by the LGU fragments.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/header_height"
    android:background="@drawable/bg_header"
    android:elevation="@dimen/elevation_sm"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <!-- "RutaRescue Mark", 36 dp. Only a picture since 2026-10-22: About and Sign out are in Settings. -->
    <ImageView
        android:id="@+id/header_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_logo_mark" />

    <!-- "Title Stack": eyebrow + wordmark, 1 dp apart -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/header_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/eyebrow_resident"
            android:textAppearance="@style/TextAppearance.RR.Eyebrow" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.RR.Title"
            android:textColor="@color/rr_navy" />
    </LinearLayout>

    <!-- Settings (2026-10-22): same 40 dp white circle as the bell; MainShellActivity opens Settings -->
    <ImageButton
        android:id="@+id/header_settings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/settings"
        android:elevation="@dimen/elevation_sm"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        app:tint="@color/rr_navy_light" />

    <!-- "Notification Button": 40 dp white circle, 24 dp bell, Elevation/Sm -->
    <ImageButton
        android:id="@+id/header_bell"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/cd_notifications"
        android:elevation="@dimen/elevation_sm"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_bell"
        app:tint="@color/rr_navy_light" />
</LinearLayout>
