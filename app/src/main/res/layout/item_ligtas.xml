<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma "Application / ..." card (LGU / Ligtas Reviews): glass, padding 14, gap 10.
    Applicant row: 38 dp circle (danger-soft when urgent, info-soft otherwise), Mobile/Section name,
    Mobile/Micro meta, Mobile/Micro state on the right ("URGENT" / "NEW"). Then the reason in
    Mobile/Body and the "Proof attached" + "Review application →" labels, 8 dp apart.
    Also used by the resident's application status list, which adds the QR button when approved.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ligtas_card"
    style="@style/RR.CardColumn"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/ripple_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ligtas_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_avatar"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ligtas_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <TextView
                android:id="@+id/ligtas_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textAppearance="@style/TextAppearance.RR.Micro" />
        </LinearLayout>

        <TextView
            android:id="@+id/ligtas_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.RR.Micro" />
    </LinearLayout>

    <!-- "Reason" -->
    <TextView
        android:id="@+id/ligtas_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/TextAppearance.RR.Body" />

    <!-- "Review Actions" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ligtas_proof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/proof_attached"
            android:textAppearance="@style/TextAppearance.RR.Label"
            android:textColor="@color/rr_green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ligtas_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.RR.Label"
            android:textColor="@color/rr_navy_light" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ligtas_qr"
        style="@style/Widget.RR.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/show_qr"
        android:visibility="gone"
        app:icon="@drawable/ic_qr" />
</LinearLayout>
