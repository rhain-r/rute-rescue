<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <LinearLayout style="@style/RR.CardColumn">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    style="@style/RR.IconTile"
                    android:src="@drawable/ic_center" />

                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.RR.Title" />

                <TextView
                    android:id="@+id/detail_status"
                    style="@style/RR.Badge" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.RR.Body" />

            <TextView
                android:id="@+id/detail_distance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />
        </LinearLayout>

        <TextView
            style="@style/RR.SectionHeader"
            android:text="@string/accessibility" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/detail_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/detail_no_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No accessibility features recorded by the LGU yet."
            android:textAppearance="@style/TextAppearance.RR.Caption"
            android:visibility="gone" />

        <TextView
            style="@style/RR.SectionHeader"
            android:text="@string/verification" />

        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:id="@+id/detail_verification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Body" />

            <TextView
                android:id="@+id/detail_freshness"
                style="@style/RR.FreshnessChip"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notice"
            android:padding="12dp"
            android:text="@string/capacity_notice"
            android:textColor="@color/rr_orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_route"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/route_here"
            app:icon="@drawable/ic_route" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/detail_save"
            style="@style/Widget.RR.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/save_place" />
    </LinearLayout>
</ScrollView>
