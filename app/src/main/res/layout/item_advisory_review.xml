<?xml version="1.0" encoding="utf-8"?>
<!--
    One advisory waiting in the LGU's approval queue (2026-10-22): the center it is about, who sent
    it and when, the text residents would read, and Decline / Accept right on the card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/RR.CardColumn">

    <TextView
        android:id="@+id/review_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RR.Label" />

    <TextView
        android:id="@+id/review_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textAllCaps="true"
        android:textAppearance="@style/TextAppearance.RR.Micro"
        android:textColor="@color/rr_orange" />

    <TextView
        android:id="@+id/review_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/TextAppearance.RR.Label" />

    <TextView
        android:id="@+id/review_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.RR.Body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_decline"
            style="@style/Widget.RR.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/decline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_accept"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/accept" />
    </LinearLayout>
</LinearLayout>
