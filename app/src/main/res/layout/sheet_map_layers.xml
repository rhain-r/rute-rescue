<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 1 frame "Client / Safe Route / Map layers" (also opened from the LGU Hazard Map).
    White bottom sheet with 30 dp top corners over a navy scrim: title and close button,
    BASE MAP (three tiles), FLOOD RISK · PROJECT NOAH (three switches + legend),
    ON THE MAP (centers, bridges/tunnels, traffic) and the Reset / Done buttons.
    The switch rows are inflated from item_layer_row.xml by MapLayersSheet.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_drag_handle"
            android:backgroundTint="@color/rr_field_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_layers_title"
                    android:textAppearance="@style/TextAppearance.RR.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/map_layers_caption"
                    android:textAppearance="@style/TextAppearance.RR.Caption"
                    android:textColor="@color/rr_text_secondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/layers_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_round_close"
                android:contentDescription="@string/close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/rr_text" />
        </LinearLayout>

        <TextView
            style="@style/RR.GroupLabel"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/layers_base_map" />

        <LinearLayout
            android:id="@+id/layers_bases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/RR.GroupLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/layers_flood_group" />

            <TextView
                android:id="@+id/layers_prepared_chip"
                style="@style/RR.SoftChip"
                android:drawableStart="@drawable/ic_prepared_data"
                android:text="@string/layers_prepared"
                android:textColor="@color/rr_text_secondary" />

            <!-- Info tooltip: the risk zones are prepared scenarios, not live weather -->
            <ImageButton
                android:id="@+id/layers_flood_info"
                style="@style/RR.InfoButton"
                android:layout_marginStart="2dp"
                android:layout_marginTop="-5dp"
                android:layout_marginEnd="-7dp"
                android:layout_marginBottom="-5dp"
                android:contentDescription="@string/cd_about_risk_zones" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layers_floods"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_layer_group"
            android:orientation="vertical" />

        <!-- Legend: Low / Medium / High (over 1.5 m) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_line_key"
                android:backgroundTint="@color/hazard_low" />

            <TextView
                style="@style/RR.LegendText"
                android:text="@string/legend_low" />

            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_line_key"
                android:backgroundTint="@color/hazard_medium" />

            <TextView
                style="@style/RR.LegendText"
                android:text="@string/legend_medium" />

            <View
                android:layout_width="14dp"
                android:layout_height="8dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_line_key"
                android:backgroundTint="@color/hazard_high" />

            <TextView
                style="@style/RR.LegendText"
                android:text="@string/legend_high" />
        </LinearLayout>

        <TextView
            style="@style/RR.GroupLabel"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/layers_on_map" />

        <LinearLayout
            android:id="@+id/layers_overlays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_layer_group"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/layers_reset"
                style="@style/Widget.RR.Button.Outline"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:minHeight="50dp"
                android:text="@string/reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/layers_done"
                style="@style/Widget.RR.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:minHeight="50dp"
                android:text="@string/done" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
