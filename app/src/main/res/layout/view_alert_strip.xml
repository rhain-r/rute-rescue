<?xml version="1.0" encoding="utf-8"?>
<!--
    The city's alert level (2026-10-22), the first line of the "Advisories" block at the top of the
    resident Home, the moderator Overview and the LGU Overview. Only the LGU sees "Change".
    Filled by ui.common.AlertStrip.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alert_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap"
    android:background="@drawable/bg_card"
    android:elevation="@dimen/elevation_sm"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/alert_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_warning"
        app:tint="@color/rr_navy_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/alert_level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.RR.Label" />

        <TextView
            android:id="@+id/alert_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.RR.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/alert_change"
        style="@style/RR.SectionAction"
        android:layout_marginStart="8dp"
        android:text="@string/change"
        android:visibility="gone" />
</LinearLayout>
