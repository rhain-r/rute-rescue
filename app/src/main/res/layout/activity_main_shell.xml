<?xml version="1.0" encoding="utf-8"?>
<!--
    Single authenticated shell (DOCX section 6). Matches the Figma frames: tab content fills the
    screen (each tab draws its own 74 dp header or map controls), and the 78 dp glass navigation bar
    sits on the bottom edge. MainShellActivity handles the status-bar and gesture-bar insets.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/shell_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Offline banner (DOCX section 11). Not in Figma; uses the Figma navy + Mobile/Caption. -->
    <TextView
        android:id="@+id/shell_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_offline_banner"
        android:drawablePadding="8dp"
        android:elevation="@dimen/elevation_float"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:text="@string/offline_banner"
        android:textAppearance="@style/TextAppearance.RR.Caption"
        android:textColor="@color/white"
        android:visibility="gone" />

    <include
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
