<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings (2026-10-22), opened from the gear in every tab's header, for every role. The rows
    reuse the compact row component (item_data_row) and are added by SettingsActivity, so each
    role only sees the rows that apply to it.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:id="@+id/settings_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Subtitle" />

            <TextView
                android:id="@+id/settings_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <TextView
                android:id="@+id/settings_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />
        </LinearLayout>

        <TextView
            style="@style/RR.SectionHeader"
            android:text="@string/settings_account" />

        <LinearLayout
            android:id="@+id/settings_account_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/settings_priority_header"
            style="@style/RR.SectionHeader"
            android:text="@string/priority_id"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/settings_priority_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 2026-10-25: LGU only - the prepared and imported datasets (moved from the Data tab) -->
        <TextView
            android:id="@+id/settings_datasets_header"
            style="@style/RR.SectionHeader"
            android:text="@string/datasets"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/settings_datasets_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/RR.SectionHeader"
            android:text="@string/settings_phone" />

        <LinearLayout
            android:id="@+id/settings_phone_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_sign_out"
            style="@style/Widget.RR.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/sign_out"
            app:icon="@drawable/ic_logout" />
    </LinearLayout>
</ScrollView>
