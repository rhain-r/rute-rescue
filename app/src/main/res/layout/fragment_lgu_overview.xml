<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma "LGU / Overview": pinned LGU header, then "Screen Content" (16 dp padding, 12 dp gap):
    Operations Status, "Today" + "View report", Metric Grid (2 x 2, 10 dp gaps), Quick operations
    (two 66 dp rows), Advisory Composer. DOCX addition: the LGU's published advisories, which the
    officer can update or archive (DOCX section 3), followed by the information-only scope note.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView style="@style/RR.TabScroll">

        <LinearLayout style="@style/RR.ScreenColumn">

            <!-- "Operations Status": 28 dp corners, padding 16, gap 8, Elevation/Float -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero_lgu"
                android:elevation="@dimen/elevation_float"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="24dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lgu_hero_city"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.RR.Eyebrow" />

                    <TextView
                        android:id="@+id/lgu_hero_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.RR.Eyebrow"
                        android:textColor="@color/rr_orange" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/operations_overview"
                    android:textAppearance="@style/TextAppearance.RR.Title" />

                <TextView
                    android:id="@+id/lgu_hero_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />
            </LinearLayout>

            <!-- "Today" + "View report" -->
            <LinearLayout style="@style/RR.SectionRow">

                <TextView
                    style="@style/RR.SectionTitle"
                    android:text="@string/today" />

                <TextView
                    android:id="@+id/lgu_view_report"
                    style="@style/RR.SectionAction"
                    android:text="@string/view_report" />
            </LinearLayout>

            <!-- "Metric Grid" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/RR.MetricTile">

                    <TextView
                        style="@style/RR.MetricLabel"
                        android:text="@string/open_reviews" />

                    <TextView
                        android:id="@+id/lgu_metric_reviews"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_reviews_sub"
                        style="@style/RR.MetricSub" />
                </LinearLayout>

                <LinearLayout
                    style="@style/RR.MetricTile"
                    android:layout_marginStart="10dp">

                    <TextView
                        style="@style/RR.MetricLabel"
                        android:text="@string/active_closures" />

                    <TextView
                        android:id="@+id/lgu_metric_closures"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_closures_sub"
                        style="@style/RR.MetricSub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/RR.MetricTile">

                    <TextView
                        style="@style/RR.MetricLabel"
                        android:text="@string/centers_label" />

                    <TextView
                        android:id="@+id/lgu_metric_centers"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_centers_sub"
                        style="@style/RR.MetricSub" />
                </LinearLayout>

                <LinearLayout
                    style="@style/RR.MetricTile"
                    android:layout_marginStart="10dp">

                    <TextView
                        style="@style/RR.MetricLabel"
                        android:text="@string/updates_label" />

                    <TextView
                        android:id="@+id/lgu_metric_updates"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_updates_sub"
                        style="@style/RR.MetricSub" />
                </LinearLayout>
            </LinearLayout>

            <!-- "Quick operations" -->
            <TextView
                style="@style/RR.SectionHeader"
                android:text="@string/quick_operations" />

            <LinearLayout
                android:id="@+id/lgu_op_reviews"
                style="@style/RR.RowCard.Compact">

                <ImageView
                    style="@style/RR.IconTile.Small"
                    android:src="@drawable/ic_reviews"
                    app:tint="@color/rr_navy_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RR.RowTitle"
                        android:text="@string/review_ligtas" />

                    <TextView
                        android:id="@+id/lgu_op_reviews_sub"
                        style="@style/RR.RowMeta" />
                </LinearLayout>

                <ImageView style="@style/RR.Chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lgu_op_advisory"
                style="@style/RR.RowCard.Compact">

                <ImageView
                    style="@style/RR.IconTile.Small"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/rr_cyan_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RR.RowTitle"
                        android:text="@string/publish_advisory" />

                    <TextView
                        style="@style/RR.RowMeta"
                        android:text="@string/publish_advisory_sub" />
                </LinearLayout>

                <ImageView style="@style/RR.Chevron" />
            </LinearLayout>

            <!-- "Advisory Composer": padding 14, gap 8 -->
            <LinearLayout style="@style/RR.CardColumn">

                <EditText
                    android:id="@+id/lgu_composer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top"
                    android:hint="@string/share_update_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:textAppearance="@style/TextAppearance.RR.Body"
                    android:textColorHint="@color/rr_text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lgu_compose_closure"
                        style="@style/RR.ComposerAction"
                        android:text="@string/add_closure"
                        android:textColor="@color/rr_navy_light" />

                    <TextView
                        android:id="@+id/lgu_compose_center"
                        style="@style/RR.ComposerAction"
                        android:text="@string/add_center"
                        android:textColor="@color/rr_accent_teal" />

                    <TextView
                        android:id="@+id/lgu_compose_publish"
                        style="@style/RR.ComposerAction"
                        android:text="@string/publish"
                        android:textColor="@color/rr_teal" />
                </LinearLayout>
            </LinearLayout>

            <!-- Published advisories (update / archive) -->
            <TextView
                style="@style/RR.SectionHeader"
                android:text="@string/your_advisories" />

            <LinearLayout
                android:id="@+id/lgu_advisories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Same component as the Figma "Scope Notice" -->
            <TextView
                style="@style/RR.Note.Info"
                android:text="@string/info_management_only" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_app_header" />
</FrameLayout>
