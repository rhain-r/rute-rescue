<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma "LGU / Overview": pinned LGU header, then "Screen Content" (16 dp padding, 12 dp gap):
    Operations Status, "Today" + "View report", Metric Grid (2 x 2, 10 dp gaps), Quick operations
    (two 66 dp rows). DOCX addition: the LGU's published advisories, which the officer can update or
    archive (DOCX section 3), followed by the information-only scope note. 2026-10-20: the Advisory
    Composer card was removed (it repeated "Publish community advisory"), and only the 3 newest
    advisories of the last 30 days are listed, with "See all advisories" for the rest.
    2026-10-22: the LGU Overview only (moderators have their own); Advisories moved to the very top,
    led by the city's alert level, which only the LGU sets.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView style="@style/RR.TabScroll">

        <LinearLayout style="@style/RR.ScreenColumn">

            <!-- 2026-10-22: Advisories at the very top - the city's alert level (the LGU can change it),
                 then (since 2026-10-25) only the newest published announcement of the last 7 days;
                 a level older than 7 days reads "No alert level set" again. The rest are in
                 Notifications (the header bell, 30 days); no "See all advisories" since 2026-10-25 -->
            <LinearLayout
                style="@style/RR.SectionRow"
                android:layout_marginTop="0dp">

                <TextView
                    style="@style/RR.SectionTitle"
                    android:text="@string/advisories" />
            </LinearLayout>

            <include layout="@layout/view_alert_strip" />

            <LinearLayout
                android:id="@+id/lgu_advisories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- "Operations Status": 28 dp corners, padding 16, gap 8, Elevation/Float -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:background="@drawable/bg_hero_lgu"
                android:elevation="@dimen/elevation_float"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="24dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lgu_hero_city"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.RR.Eyebrow" />

                    <TextView
                        android:id="@+id/lgu_hero_alert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.RR.Eyebrow"
                        android:textColor="@color/rr_orange" />
                </LinearLayout>

                <!-- 2026-10-22: a short description of the city's day instead of the big "Operations overview" title -->
                <TextView
                    android:id="@+id/lgu_hero_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.RR.Body" />

                <TextView
                    android:id="@+id/lgu_hero_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />
            </LinearLayout>

            <!-- "Today" + "View report" -->
            <LinearLayout style="@style/RR.SectionRow">

                <TextView
                    style="@style/RR.SectionTitle"
                    android:text="@string/today" />

                <TextView
                    android:id="@+id/lgu_view_report"
                    style="@style/RR.SectionAction"
                    android:text="@string/view_report" />
            </LinearLayout>

            <!-- "Metric Grid" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/RR.MetricTile">

                    <TextView
                        android:id="@+id/lgu_metric_reviews_label"
                        style="@style/RR.MetricLabel"
                        android:text="@string/waiting_for_you" />

                    <TextView
                        android:id="@+id/lgu_metric_reviews"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_reviews_sub"
                        style="@style/RR.MetricSub" />
                </LinearLayout>

                <LinearLayout
                    style="@style/RR.MetricTile"
                    android:layout_marginStart="10dp">

                    <TextView
                        style="@style/RR.MetricLabel"
                        android:text="@string/active_closures" />

                    <TextView
                        android:id="@+id/lgu_metric_closures"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_closures_sub"
                        style="@style/RR.MetricSub" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/RR.MetricTile">

                    <TextView
                        style="@style/RR.MetricLabel"
                        android:text="@string/centers_label" />

                    <TextView
                        android:id="@+id/lgu_metric_centers"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_centers_sub"
                        style="@style/RR.MetricSub" />
                </LinearLayout>

                <LinearLayout
                    style="@style/RR.MetricTile"
                    android:layout_marginStart="10dp">

                    <!-- 2026-10-25: Ligtas Priority applications pending review replaced "Updates"
                         (the change history is in View report) -->
                    <TextView
                        style="@style/RR.MetricLabel"
                        android:text="@string/ligtas_pending_label" />

                    <TextView
                        android:id="@+id/lgu_metric_ligtas"
                        style="@style/RR.MetricValue" />

                    <TextView
                        android:id="@+id/lgu_metric_ligtas_sub"
                        style="@style/RR.MetricSub"
                        android:text="@string/ligtas_pending_sub" />
                </LinearLayout>
            </LinearLayout>

            <!-- "Quick operations" -->
            <TextView
                style="@style/RR.SectionHeader"
                android:text="@string/quick_operations" />

            <LinearLayout
                android:id="@+id/lgu_op_reviews"
                style="@style/RR.RowCard.Compact">

                <ImageView
                    style="@style/RR.IconTile.Small"
                    android:src="@drawable/ic_reviews"
                    app:tint="@color/rr_navy_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lgu_op_reviews_title"
                        style="@style/RR.RowTitle"
                        android:text="@string/finalize_op" />

                    <TextView
                        android:id="@+id/lgu_op_reviews_sub"
                        style="@style/RR.RowMeta" />
                </LinearLayout>

                <ImageView style="@style/RR.Chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lgu_op_advisory"
                style="@style/RR.RowCard.Compact">

                <ImageView
                    style="@style/RR.IconTile.Small"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/rr_cyan_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lgu_op_advisory_title"
                        style="@style/RR.RowTitle"
                        android:text="@string/publish_advisory" />

                    <TextView
                        android:id="@+id/lgu_op_advisory_sub"
                        style="@style/RR.RowMeta"
                        android:text="@string/publish_advisory_sub" />
                </LinearLayout>

                <ImageView style="@style/RR.Chevron" />
            </LinearLayout>

            <!-- Same component as the Figma "Scope Notice" -->
            <TextView
                style="@style/RR.Note.Info"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/info_management_only" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_app_header" />
</FrameLayout>
