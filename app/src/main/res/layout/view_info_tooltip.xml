<?xml version="1.0" encoding="utf-8"?>
<!--
    Info tooltip bubble shown by InfoTooltip under an "i" button: a short title and a few lines
    that explain what the anchor shows. Tap the bubble or anywhere else to close it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tooltip"
    android:elevation="@dimen/elevation_float"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tooltip_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="6dp"
        android:drawableTint="@color/rr_teal"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.RR.Label"
        android:textColor="@color/white" />

    <TextView
        android:id="@+id/tooltip_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.RR.Caption"
        android:textColor="@color/white" />
</LinearLayout>
