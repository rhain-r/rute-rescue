<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/status_structure_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RR.Subtitle" />

    <RadioGroup
        android:id="@+id/status_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/status_unverified"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Passability unverified" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/status_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verified open (fresh field evidence)" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/status_closed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Closed / impassable" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Evidence"
        app:helperText="Who checked, when, and what was seen">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/status_evidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Verified-open evidence counts as fresh for 24 hours; after that the bridge is treated as unverified again."
        android:textAppearance="@style/TextAppearance.RR.Caption" />
</LinearLayout>
