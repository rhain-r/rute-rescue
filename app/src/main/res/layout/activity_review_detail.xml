<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/review_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <TextView
            android:id="@+id/review_qr_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_info_card"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.RR.Body"
            android:visibility="gone" />

        <LinearLayout style="@style/RR.CardColumn">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/review_member"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.RR.Title" />

                <TextView
                    android:id="@+id/review_status"
                    style="@style/RR.Badge" />
            </LinearLayout>

            <TextView
                android:id="@+id/review_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <TextView
                android:id="@+id/review_justification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/TextAppearance.RR.Body" />
        </LinearLayout>

        <TextView
            style="@style/RR.SectionHeader"
            android:text="Synthetic proof" />

        <ImageView
            android:id="@+id/review_proof"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_qr_frame"
            android:contentDescription="Synthetic proof image"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/review_proof_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Demo evidence only. Real IDs or medical documents must not be used in this class demo."
            android:textAppearance="@style/TextAppearance.RR.Caption" />

        <TextView
            style="@style/RR.SectionHeader"
            android:text="History" />

        <TextView
            android:id="@+id/review_history"
            style="@style/RR.CardColumn"
            android:textAppearance="@style/TextAppearance.RR.Body" />

        <LinearLayout
            android:id="@+id/review_decision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/review_reason_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/decision_reason">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/review_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/review_reject"
                    style="@style/Widget.RR.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/reject" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/review_approve"
                    style="@style/Widget.RR.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/approve" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
