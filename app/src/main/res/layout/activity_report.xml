<?xml version="1.0" encoding="utf-8"?>
<!--
    "View report" (2026-10-20): the city's numbers as charts drawn by the app (ui/common/chart).
    Toolbar, an intro line, then one glass card per chart (title, caption, chart, note) and the
    latest audit entries as text, so every number can also be read without the colours.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/report_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <TextView
            android:id="@+id/report_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="@style/TextAppearance.RR.Caption" />

        <!-- Activity per day -->
        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_activity_title"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/report_activity_caption"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <com.rutarescue.ui.common.chart.ColumnChartView
                android:id="@+id/report_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/report_activity_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.RR.Label" />
        </LinearLayout>

        <!-- Changes by kind -->
        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_kinds_title"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <TextView
                android:id="@+id/report_kinds_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <com.rutarescue.ui.common.chart.BarListView
                android:id="@+id/report_kinds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Ligtas applications by status -->
        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_ligtas_title"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/report_ligtas_caption"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <com.rutarescue.ui.common.chart.DonutChartView
                android:id="@+id/report_ligtas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Center occupancy -->
        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_centers_title"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/report_centers_caption"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <com.rutarescue.ui.common.chart.BarListView
                android:id="@+id/report_centers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/report_centers_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.RR.Caption"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Latest audit entries as text -->
        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/report_latest_title"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <LinearLayout
                android:id="@+id/report_latest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
