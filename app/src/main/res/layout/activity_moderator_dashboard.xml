<?xml version="1.0" encoding="utf-8"?>
<!--
    LGU > Finalize > Moderators and their centers > a moderator (2026-10-22): everything the LGU
    needs to know about that moderator's center, as cards and app-drawn charts (ui/common/chart):
    the moderator, the center's capacity (ring chart), its flood status (city alert level and the
    NOAH hazard at the pin for each scenario), the moderator's activity, their work by kind, and the
    center's advisories. Every chart also has its numbers in text.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <!-- The moderator -->
        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:id="@+id/dash_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Subtitle" />

            <TextView
                android:id="@+id/dash_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <TextView
                android:id="@+id/dash_center_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.RR.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dash_change_center"
                style="@style/Widget.RR.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/change_center" />
        </LinearLayout>

        <!-- Everything below is about the moderator's center (hidden while none is assigned) -->
        <LinearLayout
            android:id="@+id/dash_center_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Center status: capacity ring, headcount, last update, facilities -->
            <LinearLayout style="@style/RR.CardColumn">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dash_center_status"
                        android:textAppearance="@style/TextAppearance.RR.Section" />

                    <TextView
                        android:id="@+id/dash_status"
                        style="@style/RR.Badge"
                        android:layout_marginStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dash_center_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.RR.Label" />

                <TextView
                    android:id="@+id/dash_center_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />

                <com.rutarescue.ui.common.chart.DonutChartView
                    android:id="@+id/dash_capacity_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/dash_capacity_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.RR.Body" />

                <TextView
                    android:id="@+id/dash_last_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />

                <TextView
                    android:id="@+id/dash_facilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />
            </LinearLayout>

            <!-- Flood status: the city alert level and the NOAH hazard at the center's pin -->
            <LinearLayout style="@style/RR.CardColumn">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dash_flood_status"
                    android:textAppearance="@style/TextAppearance.RR.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/dash_flood_caption"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />

                <include layout="@layout/view_alert_strip" />

                <com.rutarescue.ui.common.chart.BarListView
                    android:id="@+id/dash_flood"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/dash_flood_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />
            </LinearLayout>

            <!-- The center's advisories by state -->
            <LinearLayout style="@style/RR.CardColumn">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dash_advisories"
                    android:textAppearance="@style/TextAppearance.RR.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/dash_advisories_caption"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />

                <com.rutarescue.ui.common.chart.DonutChartView
                    android:id="@+id/dash_advisory_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dash_open_center"
                style="@style/Widget.RR.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dash_open_center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dash_show_map"
                style="@style/Widget.RR.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="@dimen/item_gap"
                android:text="@string/show_on_map" />
        </LinearLayout>

        <!-- The moderator's own work (shown with or without a center) -->
        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dash_activity"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/dash_activity_caption"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <com.rutarescue.ui.common.chart.ColumnChartView
                android:id="@+id/dash_activity_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/dash_activity_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.RR.Label" />
        </LinearLayout>

        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dash_work"
                android:textAppearance="@style/TextAppearance.RR.Section" />

            <TextView
                android:id="@+id/dash_work_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <com.rutarescue.ui.common.chart.BarListView
                android:id="@+id/dash_work_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
