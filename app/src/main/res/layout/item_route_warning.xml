<?xml version="1.0" encoding="utf-8"?>
<!--
    One row of the Phase 1 warning drawer: 30 dp tinted icon tile, Mobile/Label title and
    Mobile/Caption detail, with a 1 dp #E8EAED line above it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rr_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/warning_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_icon_square"
            android:importantForAccessibility="no"
            android:padding="7dp"
            tools:src="@drawable/ic_warning" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/warning_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Label"
                tools:text="High flood hazard on Recto Ave" />

            <TextView
                android:id="@+id/warning_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Caption"
                android:textColor="@color/rr_text_secondary"
                tools:text="350 m in NOAH high hazard (over 1.5 m deep)" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
