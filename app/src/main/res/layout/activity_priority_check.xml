<?xml version="1.0" encoding="utf-8"?>
<!--
    Moderator: a scanned priority ID (2026-10-22). The holder's record at the top, their Ligtas
    application (own city only), then the checklist (OK / Missing per item), a note for the
    resident, and "Save check".
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/check_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:id="@+id/check_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Subtitle" />

            <TextView
                android:id="@+id/check_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />

            <TextView
                android:id="@+id/check_status"
                style="@style/RR.Badge"
                android:layout_marginTop="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/check_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/check_ligtas"
            style="@style/RR.RowCard.Compact">

            <ImageView
                style="@style/RR.IconTile.Small"
                android:src="@drawable/ic_shield_check" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RR.RowTitle"
                    android:text="@string/nav_ligtas_priority" />

                <TextView
                    android:id="@+id/check_ligtas_text"
                    style="@style/RR.RowMeta"
                    android:maxLines="5" />
            </LinearLayout>

            <ImageView
                android:id="@+id/check_ligtas_chevron"
                style="@style/RR.Chevron" />
        </LinearLayout>

        <TextView
            style="@style/RR.SectionHeader"
            android:text="@string/checklist" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/checklist_help"
            android:textAppearance="@style/TextAppearance.RR.Caption" />

        <LinearLayout
            android:id="@+id/check_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/check_note_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/check_note">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/check_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="300"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/check_save"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save_check" />
    </LinearLayout>
</ScrollView>
