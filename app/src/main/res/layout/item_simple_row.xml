<?xml version="1.0" encoding="utf-8"?>
<!--
    Generic two-line row (search results, cached routes, maneuvers, closures...), built from the
    Figma row language: 36 dp info-soft icon tile, Mobile/Label title, Mobile/Caption subtitle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_tile"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/rr_navy_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RR.Label" />

        <TextView
            android:id="@+id/row_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textAppearance="@style/TextAppearance.RR.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_badge"
        style="@style/RR.Badge"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/row_action"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove"
        android:visibility="gone"
        app:tint="@color/rr_text_secondary" />
</LinearLayout>
