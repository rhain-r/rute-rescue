<?xml version="1.0" encoding="utf-8"?>
<!--
    The resident's priority ID (2026-10-22): the card picture with its QR, "Save to phone", and
    what the moderator found at the last check (missing documents and their note).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/priority_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <TextView
            style="@style/RR.Note.Info"
            android:text="@string/priority_id_intro" />

        <ImageView
            android:id="@+id/priority_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/priority_id_picture"
            android:elevation="@dimen/elevation_sm" />

        <TextView
            android:id="@+id/priority_empty"
            style="@style/RR.CardColumn"
            android:layout_marginTop="12dp"
            android:text="@string/priority_id_none"
            android:textAppearance="@style/TextAppearance.RR.Body"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/priority_save"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/save_to_phone"
            app:icon="@drawable/ic_upload" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/priority_get"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/get_priority_id"
            android:visibility="gone" />

        <TextView
            style="@style/RR.SectionHeader"
            android:text="@string/check_at_center" />

        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:id="@+id/priority_status"
                style="@style/RR.Badge"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />

            <TextView
                android:id="@+id/priority_check_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.RR.Body" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/priority_apply"
            style="@style/Widget.RR.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/apply_ligtas_from_id" />
    </LinearLayout>
</ScrollView>
