<?xml version="1.0" encoding="utf-8"?>
<!--
    Moderator Overview (2026-10-22), in the "LGU / Overview" visual language: pinned header, then
    (1) Advisories at the very top: the city's alert level, the 3 newest advisories (the city's
    published ones and this center's pending or declined ones), "See all", "Write a center update";
    (2) My center (Manage Center): the moderator's own center with its headcount and "Manage center";
    (3) Quick operations: check a priority ID, review Ligtas applications.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView style="@style/RR.TabScroll">

        <LinearLayout style="@style/RR.ScreenColumn">

            <!-- (1) Advisories. No "See all advisories" since 2026-10-25: the header bell opens Notifications. -->
            <LinearLayout
                style="@style/RR.SectionRow"
                android:layout_marginTop="0dp">

                <TextView
                    style="@style/RR.SectionTitle"
                    android:text="@string/advisories" />
            </LinearLayout>

            <include layout="@layout/view_alert_strip" />

            <LinearLayout
                android:id="@+id/mod_advisories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/mod_write_advisory"
                style="@style/RR.RowCard.Compact">

                <ImageView
                    style="@style/RR.IconTile.Small"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/rr_cyan_icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RR.RowTitle"
                        android:text="@string/write_center_update" />

                    <TextView
                        android:id="@+id/mod_write_advisory_sub"
                        style="@style/RR.RowMeta"
                        android:maxLines="5"
                        android:text="@string/write_center_update_sub" />
                </LinearLayout>

                <ImageView style="@style/RR.Chevron" />
            </LinearLayout>

            <!-- (2) My center: Manage Center is the moderator's main view -->
            <TextView
                style="@style/RR.SectionHeader"
                android:text="@string/my_center" />

            <LinearLayout
                android:id="@+id/mod_center_card"
                style="@style/RR.CardColumn">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mod_center_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.RR.Subtitle" />

                    <TextView
                        android:id="@+id/mod_center_status"
                        style="@style/RR.Badge"
                        android:layout_marginStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/mod_center_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />

                <com.rutarescue.ui.common.CapacityGaugeView
                    android:id="@+id/mod_center_gauge"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/mod_center_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.RR.Body" />

                <TextView
                    android:id="@+id/mod_center_updated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.RR.Caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mod_center_manage"
                    style="@style/Widget.RR.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/manage_center" />
            </LinearLayout>

            <!-- (3) Quick operations -->
            <TextView
                style="@style/RR.SectionHeader"
                android:text="@string/quick_operations" />

            <LinearLayout
                android:id="@+id/mod_op_priority"
                style="@style/RR.RowCard.Compact">

                <ImageView
                    style="@style/RR.IconTile.Small"
                    android:src="@drawable/ic_qr" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RR.RowTitle"
                        android:text="@string/check_priority_id" />

                    <TextView
                        style="@style/RR.RowMeta"
                        android:maxLines="5"
                        android:text="@string/check_priority_id_sub" />
                </LinearLayout>

                <ImageView style="@style/RR.Chevron" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mod_op_reviews"
                style="@style/RR.RowCard.Compact">

                <ImageView
                    style="@style/RR.IconTile.Small"
                    android:src="@drawable/ic_reviews"
                    app:tint="@color/rr_navy_light" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/RR.RowTitle"
                        android:text="@string/review_ligtas" />

                    <TextView
                        android:id="@+id/mod_op_reviews_sub"
                        style="@style/RR.RowMeta" />
                </LinearLayout>

                <ImageView style="@style/RR.Chevron" />
            </LinearLayout>

            <TextView
                style="@style/RR.Note.Info"
                android:layout_marginTop="@dimen/section_gap"
                android:text="@string/info_management_only" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_app_header" />
</FrameLayout>
