<?xml version="1.0" encoding="utf-8"?>
<!--
    "Pick on map" for the center editor (2026-10-20): the full map, a glass toolbar card on top
    and a card at the bottom with the hint, the picked coordinates and "Use this location".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/picker_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The title sits on a glass card so it stays readable over the street map. -->
    <LinearLayout
        android:id="@+id/picker_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_sm"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <include layout="@layout/view_toolbar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/picker_sheet"
        style="@style/RR.CardColumn"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pick_location_hint"
            android:textAppearance="@style/TextAppearance.RR.Body" />

        <TextView
            android:id="@+id/picker_coordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.RR.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/picker_use"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/use_this_location" />
    </LinearLayout>
</FrameLayout>
