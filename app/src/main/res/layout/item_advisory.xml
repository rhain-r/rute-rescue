<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma "Verified LGU Update" (Client / Home): glass card, padding 14, gap 10.
    Publisher row (36 dp brand circle, Mobile/Label name, green Mobile/Micro "LGU VERIFIED • 12 min ago"),
    the post in Mobile/Body, then the "Helpful" and "Save update" actions 18 dp apart.
    The alert level (DOCX: advisories carry a level) sits on the right of the publisher row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/RR.CardColumn">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/advisory_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_avatar"
            android:backgroundTint="@color/rr_navy_light"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/advisory_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Label" />

            <TextView
                android:id="@+id/advisory_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.RR.Micro"
                android:textColor="@color/rr_green" />
        </LinearLayout>

        <TextView
            android:id="@+id/advisory_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.RR.Micro" />
    </LinearLayout>

    <!-- "Post" -->
    <TextView
        android:id="@+id/advisory_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/TextAppearance.RR.Body" />

    <!-- "Post Actions" -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/advisory_helpful"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:text="@string/advisory_helpful"
            android:textAppearance="@style/TextAppearance.RR.Label"
            android:textColor="@color/rr_navy_light" />

        <TextView
            android:id="@+id/advisory_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:background="?attr/selectableItemBackground"
            android:text="@string/advisory_save"
            android:textAppearance="@style/TextAppearance.RR.Label"
            android:textColor="@color/rr_text_secondary" />
    </LinearLayout>
</LinearLayout>
