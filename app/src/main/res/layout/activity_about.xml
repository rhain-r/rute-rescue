<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:id="@+id/about_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Subtitle" />

            <TextView
                android:id="@+id/about_role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.RR.Caption" />
        </LinearLayout>

        <TextView
            style="@style/RR.SectionHeader"
            android:text="What RutaRescue is - and is not" />

        <TextView
            android:id="@+id/about_limits"
            style="@style/RR.CardColumn"
            android:textAppearance="@style/TextAppearance.RR.Body" />

        <TextView
            style="@style/RR.SectionHeader"
            android:text="Prepared data versions" />

        <TextView
            android:id="@+id/about_data"
            style="@style/RR.CardColumn"
            android:textAppearance="@style/TextAppearance.RR.Body"
            android:textIsSelectable="true" />

        <TextView
            style="@style/RR.SectionHeader"
            android:text="Attribution" />

        <TextView
            android:id="@+id/about_attribution"
            style="@style/RR.CardColumn"
            android:textAppearance="@style/TextAppearance.RR.Body" />
        <!-- 2026-10-22: no Sign out here any more; it is in Settings, which opens this screen. -->
    </LinearLayout>
</ScrollView>
