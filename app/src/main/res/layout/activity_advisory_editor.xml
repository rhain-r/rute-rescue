<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/advisory_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <TextView
            android:id="@+id/advisory_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.RR.Eyebrow" />

        <!-- Who wrote it, "pending", or the LGU's comment when it was declined -->
        <TextView
            android:id="@+id/advisory_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_info_card"
            android:padding="14dp"
            android:textAppearance="@style/TextAppearance.RR.Body"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/advisory_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/advisory_title"
            app:counterEnabled="true"
            app:counterMaxLength="80">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/advisory_title_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/advisory_message_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/advisory_message"
            app:counterEnabled="true"
            app:counterMaxLength="600">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/advisory_message_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 2026-10-22: no level picker. Only the LGU sets the city's alert level (Overview), and an
             advisory carries the level in force when it is published. -->
        <TextView
            android:id="@+id/advisory_level_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.RR.Caption" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/advisory_published"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/published_to_residents" />

        <TextView
            android:id="@+id/advisory_rule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Publish only verified information. Every change is recorded in the audit trail with your account and the time."
            android:textAppearance="@style/TextAppearance.RR.Caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/advisory_save"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />

        <!-- LGU, for a moderator's pending advisory: accept (publish) or decline with a comment -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/advisory_accept"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/accept_and_publish"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/advisory_decline"
            style="@style/Widget.RR.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/decline"
            android:visibility="gone" />

        <!-- Moderator, for a declined advisory: start a new one from its text -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/advisory_rewrite"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/write_new_advisory"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/advisory_archive"
            style="@style/Widget.RR.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/archive"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
