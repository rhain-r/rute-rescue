<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/legacy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="32dp">

        <include layout="@layout/view_toolbar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_card"
            android:padding="14dp"
            android:text="@string/legacy_intro"
            android:textAppearance="@style/TextAppearance.RR.Body" />

        <TextView
            style="@style/RR.SectionHeader"
            android:text="Files on this phone" />

        <LinearLayout style="@style/RR.CardColumn">

            <TextView
                android:id="@+id/legacy_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.RR.Body"
                android:textIsSelectable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/legacy_reload"
                style="@style/Widget.RR.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/reload_files" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/legacy_import"
            style="@style/Widget.RR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/import_file"
            app:icon="@drawable/ic_upload" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/legacy_export"
            style="@style/Widget.RR.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/export_file"
            app:icon="@drawable/ic_file" />

        <TextView
            android:id="@+id/legacy_report_title"
            style="@style/RR.SectionHeader"
            android:text="Import report"
            android:visibility="gone" />

        <TextView
            android:id="@+id/legacy_report"
            style="@style/RR.CardColumn"
            android:textAppearance="@style/TextAppearance.RR.Body"
            android:textIsSelectable="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/legacy_records"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
