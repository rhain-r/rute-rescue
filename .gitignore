# Build output
.gradle/
build/
/captures
.externalNativeBuild
.cxx
.kotlin/

# IDE files
*.iml
.idea/
.DS_Store

# Private, per-computer settings (DOCX section 12) - never commit: the Android SDK path of
# this computer and the TomTom key (without it, routes use free OpenStreetMap routing).
local.properties

# app/google-services.json IS committed (team decision, 2026-10-15) so a downloaded copy can
# sign in: it is the Firebase app config that ships inside every APK, not a password, and
# firebase/firestore.rules decide who may read or change data. See the exception further down.

# Raw Project NOAH shapefiles and OSM exports are committed too (data/raw/, 106 MB, largest
# file 36 MB) so this repo matches the team folder; only tools/dataprep reads them.

# Firebase emulator logs
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase/.firebase/

# ---------------------------------------------------------------------------
# Extra safety rules (added 2026-10-15 before the first GitHub upload)
# ---------------------------------------------------------------------------

# Passwords, settings files, keys and certificates - never upload
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
google-services.json
!app/google-services.json
service-account*.json
*-firebase-adminsdk-*.json
secrets/

# Downloaded dependency folders
node_modules/
venv/
.venv/
__pycache__/

# Build output (app packages)
*.apk
*.aab

# System junk
.DS_Store
Thumbs.db
desktop.ini
~$*


